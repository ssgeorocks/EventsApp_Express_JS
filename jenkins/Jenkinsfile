pipeline {

    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 15, unit: 'MINUTES')
    }

    tools {
        nodejs 'node24'
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    stages{

        stage('Run API Tests') {
            steps {
                sh 'newman run tests/postman/Tests-for-Automation.postman_collection.json --reporters cli,junit --reporter-junit-export resultados.xml  '
            }
        }

    }

    post {
        always {
            junit 'resultados.xml'
        }
    }
}