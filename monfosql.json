db.productos.find().limit(2)
db.productos.find().pretty()
db.productos.insertMany([{nombre: "Calcetas", precio: 250, categoria:"Ropa", stock: 100},{nombre: "Boxers", precio: 700, categoria: "Ropa", stock:50}])
db.productos.insertOne({nombre: "Playera", precio: 500, categoria:"Ropa", stock: 100})
db.productos.insertOne({nombre: "DVD", precio: 500, categoria:"Electronica", stock: 100})
db.productos.updateOne({nombre: "Playera"}, {$set: {precio: 450}})
db.productos.updateMany({categoria: "Ropa"}, {$inc: {precio: 50}})
db.productos.deleteOne({nombre: "Boxers"})
db.productos.deleteMany({categoria: "Ropa"})
db.productos.find({precio: {$gt:500}})
db.productos.find( {  $and : [ {precio: {$lt:50}} , {categoria: "Ropa"}  ]} )

// operadores atomicos
db.productos.updateOne({nombre: "Calcetas"}, {$inc: {stock: -10}}) //disminuye el stock de las calcetas en 10 unidades
db.productos.updateOne({nombre: "DVD"}, {$inc: {stock: 20}}) //aumenta el stock en 20 unidades
// con unset
db.productos.updateOne({nombre: "DVD"}, {$unset: {descuento: ""}}) //elimina el campo "descuento" del producto DVD
db.productos.updateOne({nombre: "DVD"}, {$set: {descuento: 50}})


// Operadores complejos

db.productos.find({$or: [{precio: {$gt: 500}}, {stock: {$lt: 50}}]})
//con regex
db.productos.find({nombre: {$regex: /ca/i}}) //busca productos que contengan "ca" sin importar mayúsculas o minúsculas
db.productos.find({nombre: {$regex: /^ca/i}}) //busca productos que comiencen con "ca" sin importar mayúsculas o minúsculas
db.productos.find({nombre: {$regex: /ca$/i}}) //busca productos que terminen con "ca" sin importar mayúsculas o minúsculas
//con exist
db.productos.find({descuento: {$exists: true}}) //busca productos que tengan el campo "descuento"
db.productos.find({descuento: {$exists: false}}) //busca productos que no tengan el campo "descuento"
//con in
db.productos.find({categoria: {$in: ["Ropa", "Electrónica"]}}) //busca productos que pertenezcan a las categorías "Ropa" o "Electrónica"

//skup/limit 
db.productos.find().skip(2).limit(2) //salta los primeros 2 productos y muestra los siguientes 2

//cursores/rango para paginar 
db.productos.find().sort({precio: 1}).skip(2).limit(2) //ordena los productos por precio de menor a mayor, salta los primeros 2 y muestra los siguientes 2
// paginacion con cursores
const pageSize = 2; // número de productos por página
let lastId = null; // variable para almacenar el último ID mostrado
// función para obtener la siguiente página de productos
function getNextPage() {
  const query = lastId ? { _id: { $gt: lastId } } : {}; // si hay un último ID, busca productos con ID mayor a ese, de lo contrario busca todos los productos
  const products = db.productos.find(query).sort({ _id: 1 }).limit(pageSize).toArray(); // busca los productos según la consulta, ordenados por ID y limitados al tamaño de página
  if (products.length > 0) {
    lastId = products[products.length - 1]._id; // actualiza el último ID con el ID del último producto mostrado
  }
  return products; // devuelve los productos encontrados
}
//ejemplo de uso
console.log(getNextPage()); // muestra la primera página de productos
console.log(getNextPage()); // muestra la segunda página de productos
// reiniciar la paginación
lastId = null; // reinicia el último ID para comenzar desde el principio
console.log(getNextPage()); // muestra la primera página de productos nuevamente

// usar explain para analizar el rendimiento de una consulta
db.productos.find({precio: {$gt: 500}}).explain("executionStats") // muestra el plan de ejecución y las estadísticas de la consulta